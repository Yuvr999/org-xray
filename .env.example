# Environment Configuration Example for ORG-XRAY

# General Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-secret-key-32bytes-min

# Backend Server
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=org_xray

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Object Storage (Local File System or S3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET_NAME=org-xray-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
